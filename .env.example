# ==============================================================================
# StreetFun Environment Configuration
# ==============================================================================

# Simulation / Demo Mode Flag
# - true:  Instant interactive demo with zero wallet friction (simulates trades, graduations, chart updates)
# - false: Live on-chain execution with Anchor smart contracts & Solana RPC
NEXT_PUBLIC_USE_MOCK_DATA=true

# Solana Network & RPC Configuration
# Options: localnet | devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=localnet
NEXT_PUBLIC_SOLANA_RPC=http://127.0.0.1:8899

# StreetFun Anchor Smart Contract Program ID
NEXT_PUBLIC_PROGRAM_ID=6ZiovCkRxRJgUaCS9uftFk3eVnGDsbnDXgUV1XHybH52

# Meteora Dynamic Bonding Curve (DBC) & DLMM Program IDs
