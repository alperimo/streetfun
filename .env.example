# ==============================================================================
# StreetFun Environment Configuration
# ==============================================================================

# Simulation / Demo Mode Flag
# - true:  Instant interactive demo with zero wallet friction (simulates trades, graduations, chart updates)
# - false: Live on-chain execution with Anchor smart contracts & Solana RPC
NEXT_PUBLIC_USE_MOCK_DATA=true

# Solana Network & RPC Configuration
# Options: localnet | devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=localnet
NEXT_PUBLIC_SOLANA_RPC=http://127.0.0.1:8899

# StreetFun Anchor Smart Contract Program ID
NEXT_PUBLIC_PROGRAM_ID=6ZiovCkRxRJgUaCS9uftFk3eVnGDsbnDXgUV1XHybH52

# Meteora DBC config must be created once for each cluster. Leave blank until setup.
NEXT_PUBLIC_METEORA_DBC_PROGRAM_ID=dbcij3LWUppWqq96dh6gJWwBifmcGfLSB5D4DuSMaqN
NEXT_PUBLIC_METEORA_DBC_CONFIG_ADDRESS=
METEORA_DBC_MIGRATION_THRESHOLD_USDC=60
NEXT_PUBLIC_METEORA_DAMM_V2_MIGRATION_CONFIG=A8gMrEPJkacWkcb3DGwtJwTe16HktSEfvwtuDh2MCtck

# ==============================================================================
# Supabase Configuration (Modern Publishable & Secret Keys)
# ==============================================================================
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Modern Client-side Publishable Key (replaces legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_xxxxxxxxxxxxxxxxxxxxxx

# Modern Server-side Secret Key (replaces legacy service_role key)
SUPABASE_SECRET_KEY=sbs_xxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# Helius Webhook Indexer Configuration
# ==============================================================================
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_WEBHOOK_SECRET=your_webhook_secret_here

# ==============================================================================
# Panta Prediction Market Configuration
# ==============================================================================
# Server credentials only. Rotate the key previously committed; that key is rejected.
# pk_test/pk_live are API credential prefixes, not guarantees about Solana cluster.
PANTA_API_KEY=
PANTA_API_URL=https://live-api.panta.market/api/v1
# Generate independently with: openssl rand -hex 32
PANTA_SESSION_SECRET=
# Reviewed real market bindings; empty means no market and no prediction trading.
# See docs/panta-integration.md for the required shape and activation procedure.
PANTA_MARKET_BINDINGS_JSON=[]
